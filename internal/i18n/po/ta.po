msgid "Back"
msgstr "திரும்பவும்"

msgid "Next"
msgstr "அடுத்தது"

msgid "Finished!"
msgstr "முடிந்துவிட்டது!"

msgid "Your user account is ready to use"
msgstr "உங்கள் பயனர் கணக்கு பயன்படுத்த தயாராக உள்ளது"

msgid "Exit"
msgstr "வெளியேறு"

msgid "Progress"
msgstr "முன்னேற்றம்"

msgid "Some steps still take some time"
msgstr "சில படிகள் இன்னும் சிறிது நேரம் ஆகும்"

msgid "Checking Connection"
msgstr "இணைப்பைச் சரிபார்க்கிறது"

msgid "Please wait until the connection check is done"
msgstr "இணைப்புச் சரிபார்ப்பு முடியும் வரை காத்திருக்கவும்"

msgid "Open Settings"
msgstr "திறந்த அமைப்புகள்"

msgid "Color Scheme"
msgstr "வண்ண திட்டம்"

msgid "Choose a color scheme for your system"
msgstr "உங்கள் கணினிக்கான வண்ணத் திட்டத்தைத் தேர்ந்தெடுக்கவும்"

msgid "Light Mode"
msgstr "ஒளி பயன்முறை"

msgid "Light"
msgstr "ஒளி"

msgid "Dark Mode"
msgstr "இருண்ட முறை"

msgid "Dark"
msgstr "இருள்"

msgid "Start"
msgstr "தொடங்கு"

msgid "Accessibility"
msgstr "அணுகல்"

msgid "Let's set up your user account"
msgstr "உங்கள் பயனர் கணக்கை அமைப்போம்"

msgid "Applications"
msgstr "பயன்பாடுகள்"

msgid "Choose which applications to install."
msgstr "எந்த பயன்பாடுகளை நிறுவ வேண்டும் என்பதைத் தேர்வுசெய்க."

msgid "Browsers"
msgstr "உலாவிகள்"

msgid "Common Utilities"
msgstr "பொதுவான பயன்பாடுகள்"

msgid "Useful utilities to enhance your desktop experience"
msgstr "உங்கள் டெச்க்டாப் அனுபவத்தை மேம்படுத்த பயனுள்ள பயன்பாடுகள்"

msgid "Office"
msgstr "அலுவலகம்"

msgid "The LibreOffice suite"
msgstr "லிப்ரேஃபிச் சூட்"

msgid "Select the applications you want to install"
msgstr "நீங்கள் நிறுவ விரும்பும் பயன்பாடுகளைத் தேர்ந்தெடுக்கவும்"

msgid "Setup failed: "
msgstr "அமைப்பு தோல்வியுற்றது: "

msgid "Error log"
msgstr "பிழை பதிவு"

msgid "No Internet Connection!"
msgstr "இணைய இணைப்பு இல்லை!"

msgid "Connection available"
msgstr "இணைப்பு கிடைக்கிறது"

msgid "You have a working internet connection"
msgstr "உங்களிடம் வேலை செய்யும் இணைய இணைப்பு உள்ளது"

msgid "Hello {}!"
msgstr "வணக்கம் {}!"

msgid "Installing"
msgstr "நிறுவுகிறது"
