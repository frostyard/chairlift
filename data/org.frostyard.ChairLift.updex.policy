<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<policyconfig>
  <vendor>Frostyard</vendor>
  <vendor_url>https://github.com/frostyard/chairlift</vendor_url>
  <icon_name>org.frostyard.ChairLift</icon_name>

  <action id="org.frostyard.ChairLift.updex.enable-feature">
    <description>Enable a system feature using updex</description>
    <message>Authentication is required to enable a system feature</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/chairlift-updex-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">enable-feature</annotate>
  </action>

  <action id="org.frostyard.ChairLift.updex.disable-feature">
    <description>Disable a system feature using updex</description>
    <message>Authentication is required to disable a system feature</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/chairlift-updex-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">disable-feature</annotate>
  </action>

  <action id="org.frostyard.ChairLift.updex.update">
    <description>Update enabled system features using updex</description>
    <message>Authentication is required to update enabled system features</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/chairlift-updex-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">update</annotate>
  </action>

</policyconfig>
